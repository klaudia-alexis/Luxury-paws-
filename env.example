# Copy this file to .env and fill in your SANDBOX values.
# Never commit .env — it's already in .gitignore.

# --- Server ---
PORT=4000
# The exact URL your booking page is served from (Revolut redirects the
# customer's browser back here after checkout).
FRONTEND_URL=http://localhost:5500/luxury-paws-booking.html
# Restrict which origin is allowed to call this API. Match FRONTEND_URL's origin.
ALLOWED_ORIGIN=http://localhost:5500

# --- Revolut Sandbox ---
REVOLUT_ENV=sandbox
REVOLUT_SECRET_KEY=sk_sandbox_replace_me
REVOLUT_WEBHOOK_SECRET=whsec_replace_me

# --- Square Sandbox ---
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=replace_me_sandbox_access_token
SQUARE_LOCATION_ID=replace_me_sandbox_location_id
SQUARE_SERVICE_VARIATION_ID=replace_me_generic_grooming_service_variation_id
SQUARE_TEAM_MEMBER_KLAUDIA=replace_me_team_member_id
SQUARE_TEAM_MEMBER_MONIKA=replace_me_team_member_id
SQUARE_TEAM_MEMBER_LEAH=replace_me_team_member_id

# --- Instagram (optional — homepage shows placeholders until this is set) ---
INSTAGRAM_ACCESS_TOKEN=replace_me_long_lived_token
INSTAGRAM_USER_ID=replace_me_numeric_ig_user_id
